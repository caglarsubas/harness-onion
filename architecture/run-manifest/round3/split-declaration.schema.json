{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "planeon.internal.split-declaration/v1",
 "title": "Split declaration v1 (MAS-RA-002)",
 "$comment": "The closed shape only: uniqueness (DUPLICATE_ID), references and every later rule are the reference model's (scripts/run_manifest.py), which refuses a document as SHAPE exactly when this schema rejects it. Numbers are integers.",
 "type": "object",
 "additionalProperties": false,
 "properties": {
  "schemaVersion": {
   "const": "planeon.internal.split-declaration/v1"
  },
  "splitId": {
   "type": "string",
   "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}(?![\\s\\S])"
  },
  "suiteDigest": {
   "type": "string",
   "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
  },
  "declaredAt": {
   "type": "string",
   "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z(?![\\s\\S])"
  },
  "partitions": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "DEVELOPMENT": {
     "type": "array",
     "minItems": 0,
     "maxItems": 4096,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "taskId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}(?![\\s\\S])"
       },
       "taskDigest": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
       }
      },
      "required": [
       "taskDigest",
       "taskId"
      ]
     }
    },
    "HELD_OUT": {
     "type": "array",
     "minItems": 0,
     "maxItems": 4096,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "taskId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}(?![\\s\\S])"
       },
       "taskDigest": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
       }
      },
      "required": [
       "taskDigest",
       "taskId"
      ]
     }
    }
   },
   "required": [
    "DEVELOPMENT",
    "HELD_OUT"
   ]
  }
 },
 "required": [
  "declaredAt",
  "partitions",
  "schemaVersion",
  "splitId",
  "suiteDigest"
 ]
}
