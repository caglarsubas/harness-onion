{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "planeon.internal.run-manifest/v1",
 "title": "Run manifest v1 (MAS-RA-002)",
 "$comment": "The closed shape only: uniqueness (DUPLICATE_ID), references and every later rule are the reference model's (scripts/run_manifest.py), which refuses a document as SHAPE exactly when this schema rejects it. Numbers are integers.",
 "type": "object",
 "additionalProperties": false,
 "properties": {
  "schemaVersion": {
   "const": "planeon.internal.run-manifest/v1"
  },
  "runId": {
   "type": "string",
   "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}(?![\\s\\S])"
  },
  "scopeDigest": {
   "type": "string",
   "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
  },
  "suiteDigest": {
   "type": "string",
   "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
  },
  "configuration": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "model": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "id": {
       "type": "string",
       "minLength": 1,
       "maxLength": 128,
       "pattern": "^(?:[^\\ud800-\\udfff]|[\\ud800-\\udbff][\\udc00-\\udfff])*(?![\\s\\S])"
      },
      "configurationDigest": {
       "type": "string",
       "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
      }
     },
     "required": [
      "configurationDigest",
      "id"
     ]
    },
    "harness": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "commit": {
       "type": "string",
       "pattern": "^[0-9a-f]{40}(?![\\s\\S])"
      },
      "dirty": {
       "type": "boolean"
      }
     },
     "required": [
      "commit",
      "dirty"
     ]
    },
    "budget": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "tokensPerTask": {
       "type": "integer",
       "minimum": 1,
       "maximum": 9007199254740992
      },
      "costMicrosPerTask": {
       "type": "integer",
       "minimum": 0,
       "maximum": 9007199254740992
      },
      "wallClockSecondsPerTask": {
       "type": "integer",
       "minimum": 1,
       "maximum": 9007199254740992
      }
     },
     "required": [
      "costMicrosPerTask",
      "tokensPerTask",
      "wallClockSecondsPerTask"
     ]
    },
    "agentCount": {
     "type": "integer",
     "minimum": 1,
     "maximum": 1024
    }
   },
   "required": [
    "agentCount",
    "budget",
    "harness",
    "model"
   ]
  },
  "locks": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "specsDigest": {
     "type": "string",
     "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "promptDigests": {
     "type": "array",
     "minItems": 1,
     "maxItems": 4096,
     "items": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
     }
    },
    "toolSchemaDigests": {
     "type": "array",
     "minItems": 0,
     "maxItems": 4096,
     "items": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
     }
    },
    "imageDigests": {
     "type": "array",
     "minItems": 1,
     "maxItems": 4096,
     "items": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
     }
    },
    "dependencyLockDigests": {
     "type": "array",
     "minItems": 1,
     "maxItems": 4096,
     "items": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
     }
    },
    "fixtureDigest": {
     "type": "string",
     "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "datasetDigest": {
     "type": "string",
     "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "evaluator": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "id": {
       "type": "string",
       "minLength": 1,
       "maxLength": 128,
       "pattern": "^(?:[^\\ud800-\\udfff]|[\\ud800-\\udbff][\\udc00-\\udfff])*(?![\\s\\S])"
      },
      "version": {
       "type": "string",
       "minLength": 1,
       "maxLength": 128,
       "pattern": "^(?:[^\\ud800-\\udfff]|[\\ud800-\\udbff][\\udc00-\\udfff])*(?![\\s\\S])"
      },
      "digest": {
       "type": "string",
       "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
      }
     },
     "required": [
      "digest",
      "id",
      "version"
     ]
    },
    "environmentDigest": {
     "type": "string",
     "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    }
   },
   "required": [
    "datasetDigest",
    "dependencyLockDigests",
    "environmentDigest",
    "evaluator",
    "fixtureDigest",
    "imageDigests",
    "promptDigests",
    "specsDigest",
    "toolSchemaDigests"
   ]
  },
  "seed": {
   "oneOf": [
    {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "mode": {
       "const": "FIXED"
      },
      "value": {
       "type": "integer",
       "minimum": 0,
       "maximum": 9007199254740992
      }
     },
     "required": [
      "mode",
      "value"
     ]
    },
    {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "mode": {
       "const": "PROVIDER_UNSEEDABLE"
      },
      "statement": {
       "type": "string",
       "minLength": 1,
       "maxLength": 1024,
       "pattern": "^(?:[^\\ud800-\\udfff]|[\\ud800-\\udbff][\\udc00-\\udfff])*(?![\\s\\S])"
      }
     },
     "required": [
      "mode",
      "statement"
     ]
    }
   ]
  },
  "split": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "declarationDigest": {
     "type": "string",
     "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "partition": {
     "enum": [
      "DEVELOPMENT",
      "HELD_OUT"
     ]
    }
   },
   "required": [
    "declarationDigest",
    "partition"
   ]
  },
  "repetition": {
   "type": "integer",
   "minimum": 1,
   "maximum": 1000
  },
  "writtenAt": {
   "type": "string",
   "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z(?![\\s\\S])"
  },
  "startedAt": {
   "type": "string",
   "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z(?![\\s\\S])"
  },
  "ledgerDigest": {
   "oneOf": [
    {
     "type": "null"
    },
    {
     "type": "string",
     "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    }
   ]
  }
 },
 "required": [
  "configuration",
  "ledgerDigest",
  "locks",
  "repetition",
  "runId",
  "schemaVersion",
  "scopeDigest",
  "seed",
  "split",
  "startedAt",
  "suiteDigest",
  "writtenAt"
 ]
}
