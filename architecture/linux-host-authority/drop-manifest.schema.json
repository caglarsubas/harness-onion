{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "planeon.internal.linux-drop-manifest/v1",
 "title": "Linux drop manifest",
 "description": "The per-run drop manifest the signed-drop installer verifies under LINUX_RUNNER_MANIFEST (B-LHA-4). Its detached Ed25519 signature covers the UTF-8 schema id, one 0x00 byte and the exact bytes. Each target is one of the fixed list's exact paths (launcher-install.json fixedTargets). Closed.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schemaVersion",
  "planSha256",
  "instance",
  "bootId",
  "validFrom",
  "validUntil",
  "leaseExpiresAt",
  "signer",
  "files"
 ],
 "properties": {
  "schemaVersion": {
   "const": "planeon.internal.linux-drop-manifest/v1"
  },
  "planSha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "instance": {
   "type": "string",
   "pattern": "^[0-9]{1,20}$"
  },
  "bootId": {
   "type": "string",
   "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
  },
  "validFrom": {
   "type": "string",
   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
  },
  "validUntil": {
   "type": "string",
   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
  },
  "leaseExpiresAt": {
   "type": "string",
   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
  },
  "signer": {
   "type": "string",
   "minLength": 1,
   "maxLength": 64
  },
  "files": {
   "type": "array",
   "minItems": 1,
   "maxItems": 6,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "target",
     "sha256"
    ],
    "properties": {
     "target": {
      "enum": [
       "/etc/planeon/credentials/campaign-proxy-server-tls.crt.pem",
       "/etc/planeon/credentials/campaign-proxy-client-mtls.crt.pem",
       "/etc/planeon/harness-runner-manifest.json",
       "/etc/planeon/harness-runner-manifest.json.sig",
       "/etc/planeon/harness-live-runner-manifest.json",
       "/etc/planeon/harness-live-runner-manifest.json.sig"
      ]
     },
     "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
     }
    }
   }
  }
 }
}
