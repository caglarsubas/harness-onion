{
 "schemaVersion": "planeon.internal.authority-map-budget/v1",
 "rules": [
  {
   "id": "B1",
   "text": "Reserve before work, atomically, under the root's committed-plus-reserved counter."
  },
  {
   "id": "B2",
   "text": "A commit never exceeds its reservation; it closes the reservation COMMITTED and returns the unconsumed remainder to the root."
  },
  {
   "id": "B3",
   "text": "Reserve idempotency binds tenant, budget digest, scope, operation, dimensions and the key digest; an exact retry returns the original result, a conflicting reuse fails closed; commit and release have their own transition keys. Whether a refused reserve is kept under its key is outside these semantics, and no vector depends on it."
  },
  {
   "id": "B4",
   "text": "A cancelled or timed-out reservation with consumed usage c > 0 closes COMMITTED at c and returns the rest; with c = 0 it closes RELEASED (cancel) or EXPIRED (timeout) and returns all of it."
  },
  {
   "id": "B5",
   "text": "Estimates and local admission elsewhere (ai-gateway's request, token and concurrency budgets, inference-api's usage, H10's task and delegation budgets) hold no balance."
  }
 ],
