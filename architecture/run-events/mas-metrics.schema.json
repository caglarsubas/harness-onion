{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "planeon.internal.mas-metrics/v1",
 "title": "MAS metrics report (MAS-RA-003)",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "baseline",
  "metrics",
  "runs",
  "schemaVersion"
 ],
 "properties": {
  "schemaVersion": {
   "const": "planeon.internal.mas-metrics/v1"
  },
  "runs": {
   "type": "array",
   "minItems": 1,
   "maxItems": 65536,
   "uniqueItems": true,
   "items": {
    "type": "string",
    "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
   }
  },
  "baseline": {
   "oneOf": [
    {
     "type": "null"
    },
    {
     "type": "string",
     "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    }
   ]
  },
  "metrics": {
   "type": "array",
   "maxItems": 65536,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "denominator",
     "name",
     "numerator",
     "state",
     "unit"
    ],
    "properties": {
     "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}(?![\\s\\S])"
     },
     "unit": {
      "type": "string"
     },
     "numerator": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
     },
     "denominator": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
     },
     "state": {
      "enum": [
       "DEFINED",
       "UNDEFINED"
      ]
     }
    }
   }
  }
 }
}
