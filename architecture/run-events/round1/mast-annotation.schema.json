{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "planeon.internal.mast-annotation/v1",
 "title": "MAST annotation (MAS-RA-003)",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "annotations",
  "logDigest",
  "schemaVersion"
 ],
 "properties": {
  "schemaVersion": {
   "const": "planeon.internal.mast-annotation/v1"
  },
  "logDigest": {
   "type": "string",
   "pattern": "^sha256:[0-9a-f]{64}$"
  },
  "annotations": {
   "type": "array",
   "minItems": 1,
   "maxItems": 65536,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "annotationId",
     "annotator",
     "evidence",
     "mode"
    ],
    "properties": {
     "annotationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
     },
     "mode": {
      "enum": [
       "FM-1.1",
       "FM-1.2",
       "FM-1.3",
       "FM-1.4",
       "FM-1.5",
       "FM-2.1",
       "FM-2.2",
       "FM-2.3",
       "FM-2.4",
       "FM-2.5",
       "FM-2.6",
       "FM-3.1",
       "FM-3.2",
       "FM-3.3"
      ]
     },
     "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 65536,
      "uniqueItems": true,
      "items": {
       "type": "integer",
       "minimum": 1,
       "maximum": 9007199254740991
      }
     },
     "annotator": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
     }
    }
   }
  }
 }
}
