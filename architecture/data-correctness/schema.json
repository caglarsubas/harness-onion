    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployables",
        "byStateMode",
        "withLease",
        "withOutbox",
        "withDerivedStores",
        "withTransactionBoundary",
        "guards",
        "unspecifiedByMember",
        "obligationsByFamily",
        "vectorsByFamily"
      ],
      "properties": {
        "deployables": {
          "type": "integer",
          "minimum": 0
        },
        "byStateMode": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          },
          "propertyNames": {
            "enum": [
              "STATEFUL",
              "STATELESS_DURABLE"
            ]
          }
        },
        "withLease": {
          "type": "integer",
          "minimum": 0
        },
        "withOutbox": {
          "type": "integer",
          "minimum": 0
        },
        "withDerivedStores": {
          "type": "integer",
          "minimum": 0
        },
        "withTransactionBoundary": {
          "type": "integer",
          "minimum": 0
        },
        "guards": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          },
          "propertyNames": {
            "enum": [
              "SERIALIZABLE",
              "ROW_LOCK",
              "ADVISORY_LOCK",
              "SINGLE_WRITER",
              "APPEND_ONLY",
              "UNSPECIFIED"
            ]
          }
        },
        "unspecifiedByMember": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          },
          "propertyNames": {
            "enum": [
              "clockUse",
              "deletion",
              "feed",
              "fencing",
              "guard",
              "skewMarginMs",
              "transactionBoundary",
              "version",
              "window"
            ]
          }
        },
        "obligationsByFamily": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "RF-1",
            "RF-2",
            "RF-3",
            "RF-4",
            "RF-5",
            "RF-6",
            "RF-7"
          ],
          "properties": {
            "RF-1": {
              "type": "integer",
              "minimum": 0
            },
            "RF-2": {
              "type": "integer",
              "minimum": 0
            },
            "RF-3": {
              "type": "integer",
              "minimum": 0
            },
