{
 "$id": "planeon.internal.lab-run-plan/v1",
 "title": "GCP qualification run plan (owner approval by its sha256)",
 "type": "object",
 "description": "One run on the owner's GCP compute. Closed: every key is required and no other key is allowed.",
 "additionalProperties": false,
 "required": [
  "schemaVersion",
  "planId",
  "preparedAt",
  "purpose",
  "workload",
  "project",
  "location",
  "machines",
  "maxDurationHours",
  "cost",
  "budget",
  "exposure",
  "observer",
  "credentials",
  "teardown",
  "approval"
 ],
 "properties": {
  "schemaVersion": {
   "const": "planeon.internal.lab-run-plan/v1"
  },
  "planId": {
   "type": "string",
   "pattern": "^RP-[0-9]{8}-[a-z0-9][a-z0-9-]{0,30}[a-z0-9]$"
  },
  "preparedAt": {
   "type": "string",
   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
   "description": "The date the plan was prepared (UTC)."
  },
  "purpose": {
   "type": "object",
   "description": "Why the run happens.",
   "additionalProperties": false,
   "required": [
    "gate",
    "packetId",
    "summary"
   ],
   "properties": {
    "gate": {
     "enum": [
      "CONF-LINUX-001",
      "W06",
      "PACKET"
     ]
    },
    "packetId": {
     "type": [
      "string",
      "null"
     ],
     "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)*-[0-9]{3}$",
     "description": "Named exactly when gate is PACKET."
    },
    "summary": {
     "type": "string",
     "minLength": 1,
     "maxLength": 300
    }
   }
  },
  "workload": {
   "type": "object",
   "description": "What runs: one repository commit and the digest of the argv set the run executes.",
   "additionalProperties": false,
   "required": [
    "repository",
    "commit",
    "argvSha256",
    "description"
   ],
   "properties": {
    "repository": {
     "type": "string",
     "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "commit": {
     "type": "string",
     "pattern": "^[0-9a-f]{40}$"
    },
    "argvSha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "description": {
     "type": "string",
     "minLength": 1,
     "maxLength": 300
    }
   }
  },
  "project": {
   "type": "object",
   "description": "The run project, separate from the old lab foundation; the owner confirms separation at approval.",
   "additionalProperties": false,
   "required": [
    "id",
    "separateFromLabFoundation"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$"
    },
    "separateFromLabFoundation": {
     "const": true
    }
   }
  },
  "location": {
   "type": "object",
   "description": "Where the run happens.",
   "additionalProperties": false,
   "required": [
    "region",
    "zone"
   ],
   "properties": {
    "region": {
     "type": "string",
     "pattern": "^[a-z]+-[a-z]+[0-9]+$"
    },
    "zone": {
     "type": "string",
     "pattern": "^[a-z]+-[a-z]+[0-9]+-[a-z]$"
    }
   }
  },
  "machines": {
   "type": "array",
   "minItems": 1,
   "maxItems": 4,
   "items": {
    "type": "object",
    "description": "One machine group.",
    "additionalProperties": false,
    "required": [
     "role",
     "machineType",
     "count",
     "bootDiskGb",
     "bootDiskSku",
     "image"
    ],
    "properties": {
     "role": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,30}$"
     },
     "machineType": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*-[a-z]+(-[0-9]+)?$"
     },
     "count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
     },
     "bootDiskGb": {
      "type": "integer",
      "minimum": 10,
      "maximum": 500
     },
     "bootDiskSku": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{0,62}$",
      "description": "The rate card SKU the boot disk is priced by."
     },
     "image": {
      "type": "object",
      "description": "An image pinned by its exact name; a public image's publisher project, never an organisation's.",
      "additionalProperties": false,
      "required": [
       "project",
       "family",
       "name"
      ],
      "properties": {
       "project": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$"
       },
       "family": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
       },
       "name": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
       }
      }
     }
    }
   }
  },
  "maxDurationHours": {
   "type": "number",
   "exclusiveMinimum": 0,
   "maximum": 72
  },
  "cost": {
   "type": "object",
   "description": "The estimate: a dated rate card applied to line items, under the owner's ceiling.",
   "additionalProperties": false,
   "required": [
    "currency",
    "rateCard",
    "lineItems",
    "total",
    "ceiling"
   ],
   "properties": {
    "currency": {
     "enum": [
      "USD",
      "EUR"
     ]
    },
    "rateCard": {
     "type": "object",
     "description": "Unit prices as of a date, with their source label.",
     "additionalProperties": false,
     "required": [
      "date",
      "source",
      "rates"
     ],
     "properties": {
      "date": {
       "type": "string",
       "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
      },
      "source": {
       "type": "string",
       "minLength": 1,
       "maxLength": 200
      },
      "rates": {
       "type": "array",
       "minItems": 1,
       "items": {
        "type": "object",
        "description": "One SKU's unit price.",
        "additionalProperties": false,
        "required": [
         "sku",
         "unit",
         "price"
        ],
        "properties": {
         "sku": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]{0,62}$"
         },
         "unit": {
          "enum": [
           "hour",
           "gb-month"
          ]
         },
         "price": {
          "type": "number",
          "exclusiveMinimum": 0
         }
        }
       }
      }
     }
    },
    "lineItems": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "description": "One priced quantity.",
      "additionalProperties": false,
      "required": [
       "sku",
       "unit",
       "quantity",
       "amount"
      ],
      "properties": {
       "sku": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9.-]{0,62}$"
       },
       "unit": {
        "enum": [
         "hour",
         "gb-month"
        ]
       },
       "quantity": {
        "type": "number",
        "minimum": 0
       },
       "amount": {
        "type": "number",
        "minimum": 0
       }
      }
     }
    },
    "total": {
     "type": "number",
     "minimum": 0
    },
    "ceiling": {
     "type": "number",
     "exclusiveMinimum": 0
    }
   }
  },
  "budget": {
   "type": "object",
   "description": "Budgets only alert; they never stop spend, so the lease and teardown do.",
   "additionalProperties": false,
   "required": [
    "alertOnly",
    "alertThresholds"
   ],
   "properties": {
    "alertOnly": {
     "const": true
    },
    "alertThresholds": {
     "type": "array",
     "description": "Fractions of the owner's ceiling at which the budget alerts.",
     "minItems": 1,
     "maxItems": 4,
     "uniqueItems": true,
     "items": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1
     }
    }
   }
  },
  "exposure": {
   "type": "object",
   "description": "No external address or ingress unless listed with its reason.",
   "additionalProperties": false,
   "required": [
    "externalIp",
    "externalIpReason",
    "ingress"
   ],
   "properties": {
    "externalIp": {
     "type": "boolean"
    },
    "externalIpReason": {
     "type": [
      "string",
      "null"
     ],
     "minLength": 1,
     "maxLength": 300
    },
    "ingress": {
     "type": "array",
     "maxItems": 4,
     "items": {
      "type": "object",
      "description": "One allowed ingress.",
      "additionalProperties": false,
      "required": [
       "port",
       "protocol",
       "sourceRange",
       "reason"
      ],
      "properties": {
       "port": {
        "type": "integer",
        "minimum": 1,
        "maximum": 65535
       },
       "protocol": {
        "enum": [
         "tcp",
         "udp"
        ]
       },
       "sourceRange": {
        "type": "string",
        "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}/[0-9]{1,2}$"
       },
       "reason": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
       }
      }
     }
    }
   }
  },
  "observer": {
   "type": "object",
   "description": "The run's dedicated read-only observer, its roles bound on the run project only.",
   "additionalProperties": false,
   "required": [
    "identity",
    "scope",
    "roles",
    "exportedKeys",
    "payloadFree"
   ],
   "properties": {
    "identity": {
     "type": "string",
     "pattern": "^obs-[a-z0-9][a-z0-9-]{0,22}[a-z0-9]$"
    },
    "scope": {
     "const": "RUN_PROJECT"
    },
    "roles": {
     "type": "array",
     "minItems": 1,
     "uniqueItems": true,
     "items": {
      "enum": [
       "roles/compute.viewer",
       "roles/logging.viewer",
       "roles/monitoring.viewer",
       "roles/iam.securityReviewer"
      ]
     }
    },
    "exportedKeys": {
     "const": false
    },
    "payloadFree": {
     "const": true
    }
   }
  },
  "credentials": {
   "type": "object",
   "description": "Credentials stay with the owner; the plan carries none.",
   "additionalProperties": false,
   "required": [
    "inPlan",
    "heldBy"
   ],
   "properties": {
    "inPlan": {
     "const": false
    },
    "heldBy": {
     "const": "OWNER"
    }
   }
  },
  "teardown": {
   "type": "object",
   "description": "How the run ends, and what the separate run project may keep.",
   "additionalProperties": false,
   "required": [
    "namePrefix",
    "steps",
    "keep",
    "residualCheckBy"
   ],
   "properties": {
    "namePrefix": {
     "type": "string",
     "pattern": "^run-[a-z0-9][a-z0-9-]{0,20}[a-z0-9]-$",
     "description": "Every resource the run creates is named with this prefix; the report counts the buckets and service accounts named with it."
    },
    "steps": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
     }
    },
    "keep": {
     "type": "array",
     "uniqueItems": true,
     "items": {
      "enum": [
       "PROJECT",
       "BILLING_LINK",
       "AUDIT_LOGS",
       "OBSERVER_IDENTITY"
      ]
     }
    },
    "residualCheckBy": {
     "const": "OBSERVER"
    }
   }
  },
  "approval": {
   "type": "object",
   "description": "The owner approves the plan's canonical sha256.",
   "additionalProperties": false,
   "required": [
    "requiredFrom",
    "binds"
   ],
   "properties": {
    "requiredFrom": {
     "const": "OWNER"
    },
    "binds": {
     "const": "PLAN_SHA256"
    }
   }
  }
 }
}
