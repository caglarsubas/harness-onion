{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.planeon.ai/schemas/repository-registration-language-placement.schema.json",
  "title": "Successor Language Placement (its schema pin, its decision and rows only, append-only; MET-REGISTRY-001)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "decision",
    "repositories"
  ],
  "properties": {
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "const": "architecture/repository-registration/language-placement.schema.json"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet",
        "policy",
        "text"
      ],
      "properties": {
        "packet": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+$"
        },
        "policy": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/placement"
      }
    }
  },
  "$defs": {
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "rNumber",
        "languages",
        "toolchain",
        "sources"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "pattern": "^mas-harness-[a-z0-9-]+$"
        },
        "rNumber": {
          "type": "string",
          "pattern": "^R[0-9]{2}$"
        },
        "languages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "PYTHON",
              "GO",
              "RUST",
              "TYPESCRIPT",
              "UPSTREAM_OWN"
            ]
          }
        },
        "toolchain": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/span"
          }
        }
      }
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "section",
        "lines",
        "sha256",
        "evidence"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^docs/repositories/[0-9]{2}-[a-z0-9-]+[.]md$"
        },
        "section": {
          "type": "string",
          "pattern": "^#{1,6} "
        },
        "lines": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
