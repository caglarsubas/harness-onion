{
  "schemaVersion": "harness.planeon.ai/agent-loop-compaction-vectors/v1",
  "cases": [
    {
      "id": "CG-C1-P1",
      "family": "C1",
      "polarity": "POSITIVE",
      "title": "one lock bracket holds only the compaction's own HOOK, COMPACT and GATE steps",
      "input": {
        "events": [
          {
            "op": "open"
          },
          {
            "op": "step",
            "kind": "MODEL",
            "own": false
          },
          {
            "op": "lock"
          },
          {
            "op": "step",
            "kind": "HOOK",
            "own": true
          },
          {
            "op": "step",
            "kind": "COMPACT",
            "own": true
          },
          {
            "op": "step",
            "kind": "GATE",
            "own": true
          },
          {
            "op": "unlock"
          },
          {
            "op": "step",
            "kind": "MODEL",
            "own": false
          }
        ]
      },
      "expect": {
        "accept": true,
        "result": {
          "locksClosed": 1,
          "orphanEvents": 0,
          "restores": 0
        }
      }
    },
    {
