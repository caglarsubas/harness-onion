  {
   "id": "K01",
   "grounds": "E2E-10",
   "case": "an approval past its expiry, or already used",
   "expected": "blocked; a fresh, scoped approval is needed"
  },
  {
   "id": "K02",
   "grounds": "P28",
   "case": "an approval replayed for a different digest, or head",
   "expected": "refused"
  },
  {
   "id": "K03",
   "grounds": "P28",
   "case": "a bundle holding only the generator's own result",
   "expected": "no activation"
  },
  {
   "id": "K04",
   "grounds": "E2E-14",
   "case": "the self-score passes, the independent gate fails",
   "expected": "no activation; the rejection and its evidence are kept"
  },
  {
   "id": "K05",
   "grounds": "E2E-13",
   "case": "a refused attempt",
   "expected": "Trust enforcement unchanged; the attempt is audited"
  },
  {
   "id": "K06",
   "grounds": "Q-ES-D3 (a)",
   "case": "a tree mismatch after a merge",
   "expected": "stop, record and report; a revert is a new PR"
  },
  {
   "id": "K07",
   "grounds": "E2E-16",
   "case": "an evolvable class rolled back by its activator under policy, to the most recent earlier version activated under a then-valid approval and still CERTIFIED",
   "expected": "allowed; the regressed version's artifacts and lineage are kept"
  },
  {
   "id": "K08",
   "grounds": "E2E-16",
   "case": "an approval-free rollback of a never-autonomous or role-governing class, or at the programme level",
   "expected": "refused; a fresh approval is needed"
  },
  {
   "id": "K09",
   "grounds": "H14",
   "case": "a rollback to a version that is deprecated, retired or revoked",
   "expected": "refused"
  },
  {
   "id": "K10",
   "grounds": "E2E-16",
   "case": "a canary exhibits a verified regression",
   "expected": "exposure contained; rollback or mitigation follows policy; artifacts and lineage kept"
  },
  {
   "id": "K11",
   "grounds": "Q-ES-D3 (a); MONITOR.md section 4",
   "case": "main moved after the verify, before the merge",
   "expected": "no merge; the monitor stops, records it and reports to the owner; a merge needs a verify whose main sha equals current main, on a head that contains it, and a re-pushed head needs a new approval"
  },
  {
   "id": "K12",
   "grounds": "Q-ES-D3 (a)",
   "case": "a merge-decision record that does not bind the full 40-hex head sha",
   "expected": "refused as a record"
  }
