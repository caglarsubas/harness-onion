{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.planeon.ai/schemas/reuse-map.v1alpha1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sources",
    "sourceInventory",
    "pathAuthority",
    "authorizationAuthority"
  ],
  "properties": {
    "schemaVersion": {"const": "harness.planeon.ai/reuse-map/v1alpha1"},
    "sources": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/source"}
    },
    "sourceInventory": {"$ref": "#/$defs/sourceInventory"},
    "pathAuthority": {"const": "architecture/reuse-path-index.yaml"},
    "authorizationAuthority": {"const": "legal/source-reuse-authorization.yaml"}
  },
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "repository": {
      "enum": [
        "git@github.com:caglarsubas/llm_inference_engine.git",
        "git@github.com:caglarsubas/data-source-harness.git",
        "git@github.com:caglarsubas/agent-hook-v2.git",
        "git@github.com:caglarsubas/orchestra-openshift-reference-lab.git",
        "git@github.com:caglarsubas/planeon-orchestra-python-sdk.git"
      ]
    },
    "destination": {
      "enum": [
        "contracts",
        "sdks",
        "industry-packs",
        "control-plane",
        "runtime-plane",
        "model-plane",
        "knowledge-plane",
        "execution-plane",
        "trust-plane",
        "operator",
        "distribution",
        "conformance-labs"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "licenseDisposition",
        "destinations",
        "excluded",
        "excludedPathPatterns"
      ],
      "properties": {
        "repository": {"$ref": "#/$defs/repository"},
        "commit": {"$ref": "#/$defs/sha1"},
        "licenseDisposition": {"const": "path-review-required-before-copy"},
        "destinations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/destination"}
        },
        "excluded": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "excludedPathPatterns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "sourceInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approvedRepositoryCount",
        "publiclyRecordedCount",
        "metadataOmittedCount",
        "copyAuthorization"
      ],
      "properties": {
        "approvedRepositoryCount": {"const": 5},
        "publiclyRecordedCount": {"const": 5},
        "metadataOmittedCount": {"const": 0},
        "copyAuthorization": {"const": "NONE"}
      }
    }
  }
}
