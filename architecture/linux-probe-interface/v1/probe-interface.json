          "a header name, compared case-insensitively, is not host, content-type, content-length or connection",
          "a header name repeats",
          "a header value is empty or has a byte outside 32-126"
        ]
      },
      {
        "code": "HTTP_BODY_SIZE",
        "applies": "both",
        "stage": "parse",
        "rules": [
          "the Content-Length value is 0",
          "the Content-Length value exceeds 4194304 (response) or 16384 (request)"
        ]
      },
      {
        "code": "HTTP_STATUS_INVALID",
        "applies": "response",
        "stage": "parse",
        "rules": [
          "the status line is not exactly HTTP/1.1 200 OK"
        ]
      },
      {
        "code": "HTTP_REQUEST_TARGET",
        "applies": "request",
        "stage": "parse",
        "rules": [
          "the request line is not POST <path> HTTP/1.1 for one of the ten case paths",
          "the Host value differs from the expected server name"
        ]
      },
      {
        "code": "HTTP_SURPLUS",
        "applies": "both",
        "stage": "parse",
        "rules": [
          "more body bytes arrive than the Content-Length value",
          "for a response, a byte can be read after the body"
        ]
      },
      {
        "code": "HTTP_TRUNCATED_BODY",
        "applies": "both",
        "stage": "parse",
        "rules": [
          "the stream ends before the Content-Length value's body bytes arrive"
        ]
      },
      {
        "code": "HTTP_PIPELINING",
        "applies": "both",
        "stage": "parse",
        "rules": [
          "decrypted bytes remain buffered after the message"
        ]
      },
      {
        "code": "HTTP_BUFFERED_RECORD_SURPLUS",
        "applies": "request",
        "stage": "parse",
        "rules": [
          "encrypted TLS bytes remain buffered after the request message"
        ]
      }
    ]
  }
}
