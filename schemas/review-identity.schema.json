{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "planeon.review-identity/v2",
 "title": "Review identity v2 (written by the operator, LANE_SESSION only)",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "author",
  "briefSha256",
  "finished",
  "interruptions",
  "launched",
  "operator",
  "operatorRelays",
  "record",
  "reviewer",
  "rulesSha256",
  "ruling",
  "runs",
  "schemaVersion",
  "subject",
  "wrapperSha256"
 ],
 "properties": {
  "schemaVersion": {
   "const": "planeon.review-identity/v2"
  },
  "record": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "path",
    "sha256"
   ],
   "properties": {
    "path": {
     "type": "string",
     "pattern": "^(?!/)(?!(?:.*/)?\\.\\.?(?:/|(?![\\s\\S])))(?:[A-Za-z0-9_.-]+/)*[A-Za-z0-9_.-]+(?![\\s\\S])"
    },
    "sha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    }
   }
  },
  "reviewer": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "agentId",
    "agentType",
    "model"
   ],
   "properties": {
    "agentId": {
     "type": "string",
     "maxLength": 4000
    },
    "agentType": {
     "type": "string",
     "minLength": 1,
     "maxLength": 4000
    },
    "model": {
     "type": "string",
     "minLength": 1,
     "maxLength": 4000
    }
   }
  },
  "operator": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "agentId",
    "role"
   ],
   "properties": {
    "role": {
     "const": "LANE_SESSION"
    },
    "agentId": {
     "type": "string",
     "maxLength": 4000
    },
    "lane": {
     "type": "string",
     "minLength": 1,
     "maxLength": 4000
    }
   }
  },
  "author": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "agentIds"
   ],
   "properties": {
    "agentIds": {
     "type": "array",
     "minItems": 1,
     "uniqueItems": true,
     "items": {
      "type": "string",
      "maxLength": 4000
     }
    }
   }
  },
  "briefSha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
  },
  "rulesSha256": {
   "oneOf": [
    {
     "type": "string",
     "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    {
     "type": "null"
    }
   ]
  },
  "wrapperSha256": {
   "oneOf": [
    {
     "type": "string",
     "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    {
     "type": "null"
    }
   ]
  },
  "subject": {
   "oneOf": [
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "commit",
      "repository",
      "tree"
     ],
     "properties": {
      "repository": {
       "type": "string",
       "pattern": "^[A-Za-z0-9._-]{1,100}(?![\\s\\S])"
      },
      "commit": {
       "type": "string",
       "pattern": "^[0-9a-f]{40}(?![\\s\\S])"
      },
      "tree": {
       "type": "string",
       "pattern": "^[0-9a-f]{40}(?![\\s\\S])"
      }
     }
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "path",
      "sha256"
     ],
     "properties": {
      "path": {
       "type": "string",
       "pattern": "^(?!/)(?!(?:.*/)?\\.\\.?(?:/|(?![\\s\\S])))(?:[A-Za-z0-9_.-]+/)*[A-Za-z0-9_.-]+(?![\\s\\S])"
      },
      "sha256": {
       "type": "string",
       "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
      }
     }
    }
   ]
  },
  "launched": {
   "type": "string",
   "format": "date-time",
   "pattern": "^(?!0000)[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])(?![\\s\\S])"
  },
  "finished": {
   "type": "string",
   "format": "date-time",
   "pattern": "^(?!0000)[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])(?![\\s\\S])"
  },
  "interruptions": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1,
    "maxLength": 4000
   }
  },
  "operatorRelays": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1,
    "maxLength": 4000
   }
  },
  "runs": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "limit",
     "used"
    ],
    "properties": {
     "limit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
     },
     "used": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
     }
    }
   }
  },
  "ruling": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "decision"
   ],
   "properties": {
    "decision": {
     "enum": [
      "NONE_NEEDED",
      "PENDING",
      "KEEP",
      "VOID"
     ]
    },
    "by": {
     "enum": [
      "LANE_MONITOR",
      "OWNER"
     ]
    },
    "ref": {
     "type": "string",
     "minLength": 1,
     "maxLength": 4000
    },
    "date": {
     "type": "string",
     "format": "date",
     "pattern": "^(?!0000)[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])(?![\\s\\S])"
    }
   }
  },
  "base": {
   "oneOf": [
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "commit",
      "repository",
      "tree"
     ],
     "properties": {
      "repository": {
       "type": "string",
       "pattern": "^[A-Za-z0-9._-]{1,100}(?![\\s\\S])"
      },
      "commit": {
       "type": "string",
       "pattern": "^[0-9a-f]{40}(?![\\s\\S])"
      },
      "tree": {
       "type": "string",
       "pattern": "^[0-9a-f]{40}(?![\\s\\S])"
      }
     }
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "path",
      "sha256"
     ],
     "properties": {
      "path": {
       "type": "string",
       "pattern": "^(?!/)(?!(?:.*/)?\\.\\.?(?:/|(?![\\s\\S])))(?:[A-Za-z0-9_.-]+/)*[A-Za-z0-9_.-]+(?![\\s\\S])"
      },
      "sha256": {
       "type": "string",
       "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
      }
     }
    }
   ]
  }
 }
}
