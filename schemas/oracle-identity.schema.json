{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "planeon.oracle-identity/v1",
 "title": "Oracle identity v1 (D5a; written by the operator, LANE_SESSION only)",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "author",
  "briefSha256",
  "candidateCommit",
  "file",
  "finished",
  "launched",
  "operator",
  "oracle",
  "ruling",
  "schemaVersion"
 ],
 "properties": {
  "schemaVersion": {
   "const": "planeon.oracle-identity/v1"
  },
  "file": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "path",
    "sha256"
   ],
   "properties": {
    "path": {
     "type": "string",
     "pattern": "^(?!/)(?!(?:.*/)?\\.\\.?(?:/|(?![\\s\\S])))(?:[A-Za-z0-9_.-]+/)*[A-Za-z0-9_.-]+(?![\\s\\S])"
    },
    "sha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    }
   }
  },
  "oracle": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "agentId",
    "model"
   ],
   "properties": {
    "agentId": {
     "type": "string",
     "maxLength": 4000
    },
    "model": {
     "type": "string",
     "minLength": 1,
     "maxLength": 4000
    }
   }
  },
  "operator": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "agentId",
    "role"
   ],
   "properties": {
    "role": {
     "const": "LANE_SESSION"
    },
    "agentId": {
     "type": "string",
     "maxLength": 4000
    },
    "lane": {
     "type": "string",
     "minLength": 1,
     "maxLength": 4000
    }
   }
  },
  "author": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "agentIds"
   ],
   "properties": {
    "agentIds": {
     "type": "array",
     "minItems": 1,
     "uniqueItems": true,
     "items": {
      "type": "string",
      "maxLength": 4000
     }
    }
   }
  },
  "briefSha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
  },
  "candidateCommit": {
   "type": "string",
   "pattern": "^[0-9a-f]{40}(?![\\s\\S])"
  },
  "launched": {
   "type": "string",
   "format": "date-time",
   "pattern": "^(?!0000)[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])(?![\\s\\S])"
  },
  "finished": {
   "type": "string",
   "format": "date-time",
   "pattern": "^(?!0000)[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])(?![\\s\\S])"
  },
  "ruling": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "decision"
   ],
   "properties": {
    "decision": {
     "enum": [
      "NONE_NEEDED",
      "PENDING",
      "KEEP",
      "VOID"
     ]
    },
    "by": {
     "enum": [
      "LANE_MONITOR",
      "OWNER"
     ]
    },
    "ref": {
     "type": "string",
     "minLength": 1,
     "maxLength": 4000
    },
    "date": {
     "type": "string",
     "format": "date",
     "pattern": "^(?!0000)[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])(?![\\s\\S])"
    }
   }
  },
  "disclosures": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1,
    "maxLength": 4000
   }
  }
 }
}
