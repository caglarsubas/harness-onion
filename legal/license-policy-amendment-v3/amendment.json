  "rulings": [
    {
      "id": "Q-W1",
      "selected": "option 1",
      "text": "W-3 as written: a repository with no licence file takes DEFAULT_ALLOWED only when its README declares a defaultAllowed SPDX id in its metadata and the card's own text states that the licence covers the weights; a metadata tag alone gives UNKNOWN."
    },
    {
      "id": "Q-W3",
      "selected": "option 1",
      "text": "The CPU row's GGUF is the licensor's own release, if the pinned read shows one whose licence file equals the base's; the fetch itself is the owner's, and none is made in this packet."
    },
    {
      "id": "Q-W4",
      "selected": "option 1",
      "text": "A row without pinned digests fails when it is served (C-7); candidate rows may stand MISSING_PLANNED."
    }
  ],
  "rulingsBy": "Build-R00-HarnessOnion at 297's contract round (Q-C297-5 (a)), accepted by Lane-Orchestration (ORC-297-CONTRACT-RULED)",
